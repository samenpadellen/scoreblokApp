<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>nl.scoreblok.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>scoreblok</string>
			</array>
		</dict>
	</array>
	<key>NSBonjourServices</key>
	<array>
		<string>_scoreblok-sync._tcp</string>
		<string>_scoreblok-sync._udp</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>Scoreblok gebruikt de camera voor een profielfoto van een speler, en om de QR-code van een ander apparaat te scannen zodat jullie potjes kunnen samenvoegen.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>NSUserActivityTypes</key>
	<array>
		<string>nl.scoreblok.app.potje</string>
	</array>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Scoreblok zoekt een apparaat in de buurt om potjes mee samen te voegen. Er gaat niets via internet.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
</dict>
</plist>
